{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PROTECT Suite",
  "version": "0.1.0",
  "identifier": "org.protect.suite",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PROTECT Suite",
        "width": 1120,
        "height": 740,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
